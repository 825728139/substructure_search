{
  "profile_id": "pilot-v0-unmeasured",
  "status": "proposed_not_benchmarked",
  "rule_set": "requires_reviewed_version",
  "max_core_seeds": 12,
  "max_cut_plans": 16,
  "max_views_per_parent": 4,
  "max_total_tasks": 40,
  "task_budget_unit": "dispatched_attempt",
  "max_candidate_records_received": 2000,
  "candidate_page_size": 100,
  "matching_batch_size": 100,
  "reaction_analysis_batch_size": 5,
  "reserved_reaction_analysis_tasks": 4,
  "max_related_record_edges": 2,
  "max_record_expansion_tasks": 6,
  "max_unique_returned_records": 18,
  "minimum_records_per_layer_if_available": 4,
  "global_time_budget_ms": 10000,
  "rules": [
    "all_task_channels_share_the_global_budget",
    "inapplicable_layers_do_not_generate_dummy_tasks",
    "enumeration_truncation_is_not_exhaustive_no_hit",
    "returned_record_limits_do_not_establish_global_top_k",
    "no_prediction_model_before_reference_package"
  ],
  "single_reactant_transfer": {
    "status": "proposed_not_benchmarked",
    "max_source_reactions": 6,
    "max_candidates_per_source": 2,
    "max_replay_mappings_per_candidate": 16,
    "max_recursive_transfers": 0,
    "shares_global_time_budget": true
  },
  "topology_analysis": {
    "status": "proposed_not_benchmarked",
    "mode": "post_retrieval_observed_reactions",
    "generate_virtual_ring_precursors_before_hit": false,
    "candidate_sampling": "round_robin_across_products_and_structure_levels",
    "source_anchored_followups_only": true,
    "shares_total_time_budget": true
  },
  "default_substructure_query_form": "markush_family",
  "default_optional_R_policy": "unconstrained_except_declared_attachment_and_required_chemical_features",
  "markush_queries": {
    "status": "proposed_not_benchmarked",
    "enabled_by_default": true,
    "exact_identity_parallel": true,
    "max_families_per_target": 12,
    "max_core_mappings_checked_per_candidate": 128,
    "mapping_enumeration_uniquify": false,
    "mapping_overflow_detection_extra": 1,
    "max_sidechain_atom_visits_per_mapping": 10000,
    "default_R_heavy_atom_limit": null,
    "require_joint_same_instance_witness": true,
    "on_resource_or_unsupported_limit": "unassessed_or_truncated_never_silent_pass_or_fail",
    "shares_total_task_and_time_budget": true
  },
  "initial_families_per_applicable_layer": 1,
  "max_reaction_records_analyzed": 60,
  "source_execution": {
    "primary_recall": "indexed_substructure",
    "require_morgan_similarity_threshold": false,
    "full_scan_fallback": "bounded_fixture_or_explicit_offline",
    "similarity_priority": {
      "enabled": true,
      "max_candidates": 100,
      "merge_with_primary": "union",
      "shares_global_budget": true,
      "activation": "whole_core_or_broad_query",
      "primary_channel_required_for_complete": true
    },
    "source_query_timeout_ms": 1500,
    "broad_query": {
      "default_goal": "bounded_reference_results",
      "exact_count_before_first_page": false,
      "automatic_retry_of_slow_query": false,
      "on_timeout": "partial_with_backend_cancellation",
      "exhaustive_search": "explicit_background_job_on_fixed_source"
    },
    "molecular_size_priority": {
      "enabled": true,
      "status": "proposed_requires_layer_specific_calibration",
      "layers": [
        "whole",
        "core"
      ],
      "comparison_view": "same_versioned_component_or_parent_policy",
      "features": [
        "molecular_weight_ratio",
        "heavy_atom_count_ratio",
        "target_coverage",
        "reference_coverage",
        "extra_heavy_atoms"
      ],
      "window_policy": "near_first_then_relax_when_evidence_insufficient",
      "fragment_policy": "local_coverage_and_reaction_site_not_full_target_mass",
      "selection_scope_must_be_reported": true
    }
  }
}
