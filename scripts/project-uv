#!/usr/bin/env python3
"""运行 uv，并将解释器、虚拟环境和缓存限定在当前项目目录内。"""

import os
import sys
from pathlib import Path

root = Path(__file__).resolve().parents[1]
os.chdir(root)
os.environ["UV_PYTHON_INSTALL_DIR"] = str(root / ".runtime" / "python")
os.environ["UV_PROJECT_ENVIRONMENT"] = str(root / ".venv")
os.environ["UV_CACHE_DIR"] = str(root / ".cache" / "uv")
os.execvp("uv", ["uv", *sys.argv[1:]])
