# 默认合成示例；真实来源可切换为 jsonl 或 postgres。
RR_SOURCE_KIND=jsonl
RR_STORE_PATH=var/runs
RR_MAX_CONCURRENT_RUNS=2
RR_MAX_QUEUED_RUNS=16
RR_SOURCE_TIMEOUT_MS=1500
# 默认使用去重v3并选实际合格来源；仅显式兼容旧库时设为reactions。
RR_POSTGRES_TABLE=reaction_v3
# RR_SOURCE_PATH=/absolute/path/to/reactions.jsonl
# RR_EVIDENCE_PATH=/absolute/path/to/reviewed-evidence.jsonl
# RR_POSTGRES_DSN=host=YOUR_HOST port=YOUR_PORT dbname=YOUR_DB user=YOUR_USER password=YOUR_PASSWORD
# RR_API_TOKEN=YOUR_INTERNAL_TOKEN
# RR_CURSOR_SECRET=YOUR_STABLE_RANDOM_SECRET
