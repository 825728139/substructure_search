# 默认合成示例；真实来源可切换为 jsonl 或 postgres。
RR_SOURCE_KIND=jsonl
RR_STORE_PATH=var/runs
RR_MAX_CONCURRENT_RUNS=2
RR_MAX_QUEUED_RUNS=16
RR_SOURCE_TIMEOUT_MS=1500
