    "/v1/search-runs": {
      "post": {
        "summary": "Submit",
        "description": "校验幂等键长度后提交检索，返回 202 和初始 RunState。\n\nSearchRequest 由 FastAPI/Pydantic 先校验，化学计算在独立进程中进行；同键异请求按 409 处理。",
        "operationId": "submit_v1_search_runs_post",
        "parameters": [
          {
            "name": "idempotency-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
