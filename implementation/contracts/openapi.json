    "/v1/search-runs/{run_id}/rerank": {
      "post": {
        "summary": "Rerank",
        "description": "在当前访问范围内创建冻结证据重排 run，返回 202 和派生状态。\n\n请求仅有排序偏好与实验限制，目标或来源条件变化必须另开新检索。",
        "operationId": "rerank_v1_search_runs__run_id__rerank_post",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
