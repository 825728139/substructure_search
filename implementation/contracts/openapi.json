  "components": {
    "schemas": {
      "BudgetConfig": {
        "properties": {
          "time_ms": {
            "type": "integer",
            "maximum": 120000.0,
            "minimum": 50.0,
            "title": "Time Ms",
            "default": 10000
          },
          "max_tasks": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 4.0,
            "title": "Max Tasks",
            "default": 40
          },
          "max_families": {
            "type": "integer",
            "maximum": 48.0,
            "minimum": 3.0,
            "title": "Max Families",
            "default": 12
          },
          "max_candidates": {
            "type": "integer",
            "maximum": 20000.0,
            "minimum": 1.0,
            "title": "Max Candidates",
            "default": 2000
          },
          "page_size": {
            "type": "integer",
            "maximum": 500.0,
            "minimum": 1.0,
            "title": "Page Size",
            "default": 100
          },
          "max_mappings": {
            "type": "integer",
            "maximum": 2048.0,
            "minimum": 1.0,
            "title": "Max Mappings",
            "default": 128
          },
          "max_atom_visits": {
            "type": "integer",
            "maximum": 100000.0,
            "minimum": 16.0,
            "title": "Max Atom Visits",
            "default": 10000
          },
          "max_reactions": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Max Reactions",
            "default": 60
          },
          "max_proposals": {
            "type": "integer",
            "maximum": 24.0,
            "minimum": 0.0,
            "title": "Max Proposals",
            "default": 12
          },
          "max_replay_sets": {
            "type": "integer",
            "maximum": 128.0,
            "minimum": 1.0,
            "title": "Max Replay Sets",
            "default": 16
          },
          "max_display": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 3.0,
            "title": "Max Display",
            "default": 18
          },
          "max_summary_bytes": {
            "type": "integer",
            "maximum": 262144.0,
            "minimum": 256.0,
            "title": "Max Summary Bytes",
            "default": 65536
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "BudgetConfig",
        "description": "单次检索的资源上限；time_ms 为毫秒，其他字段为有明确范围的计数/字节限额。"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LabContext": {
        "properties": {
          "max_temperature_c": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Temperature C"
          },
          "min_temperature_c": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Temperature C"
          },
          "max_pressure_kpa": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Pressure Kpa"
          },
          "excluded_material_smiles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Excluded Material Smiles"
          },
          "available_equipment": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Available Equipment"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "LabContext",
        "description": "内部实验能力和明确排除条件；未提供的字段表示未限制，不表示已通过。"
      },
      "RerankRequest": {
        "properties": {
          "ranking_profile": {
            "type": "string",
            "enum": [
              "reference_first",
              "lab_fit",
              "process_reference"
            ],
            "title": "Ranking Profile",
            "default": "reference_first"
          },
          "lab_context": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LabContext"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "RerankRequest",
        "description": "仅改变排序偏好和实验能力，禁止在冻结快照重排时更换目标或候选选择范围。"
      },
      "SearchOptions": {
        "properties": {
          "include_exact_identity": {
            "type": "boolean",
            "title": "Include Exact Identity",
            "default": true
          },
          "include_proposals": {
            "type": "boolean",
            "title": "Include Proposals",
            "default": true
          },
          "include_usage": {
            "type": "boolean",
            "title": "Include Usage",
            "default": true
          },
          "exhaustive_fixture": {
            "type": "boolean",
            "title": "Exhaustive Fixture",
            "default": false
          },
          "directed_followups": {
            "type": "boolean",
            "title": "Directed Followups",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "SearchOptions",
        "description": "决定是否查完整目标、输入使用、替换建议和定向补查；有限样本穷尽不是全库穷尽。"
      },
      "SearchRequest": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1",
            "title": "Schema Version",
            "default": "1"
          },
          "target": {
            "$ref": "#/components/schemas/Target"
          },
          "retrieval_profile": {
            "type": "string",
            "enum": [
              "reference-v1",
              "pilot-v0-unmeasured"
            ],
            "title": "Retrieval Profile",
            "default": "reference-v1"
          },
          "ranking_profile": {
            "type": "string",
            "enum": [
