    "/v1/search-runs/{run_id}": {
      "get": {
        "summary": "Status",
        "description": "读取访问范围内的运行状态，并附上最新已保存快照的统计与完整性。\n\nqueued/running 也可能已有阶段包；latest_snapshot_id 供客户端判断是否切换显示。",
        "operationId": "status_v1_search_runs__run_id__get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
