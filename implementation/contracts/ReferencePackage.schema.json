            "any",
            "alkyl",
            "aryl",
            "heteroaryl"
          ],
          "title": "Category",
          "type": "string"
        },
        "exact_fragment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exact Fragment"
        },
        "max_carbons": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Carbons"
        }
      },
      "required": [
        "position"
      ],
      "title": "RConstraint",
      "type": "object"
    },
