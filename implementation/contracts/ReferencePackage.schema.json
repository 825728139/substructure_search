{
  "$defs": {
    "BondChange": {
      "additionalProperties": false,
      "description": "按来源正原子映射号记录的一对键变化，before/after 为键型而非目标索引。",
      "properties": {
        "maps": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Maps",
          "type": "array"
        },
        "before": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before"
        },
        "after": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After"
        }
      },
      "required": [
        "maps"
      ],
      "title": "BondChange",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "description": "绑定具体材料主体和来源的证据主张；报告、图推定、合成示例与未知明确分开。",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "subject_id": {
          "title": "Subject Id",
          "type": "string"
        },
        "predicate": {
          "title": "Predicate",
          "type": "string"
        },
        "support": {
          "enum": [
            "source_reported",
            "graph_inference",
            "synthetic_illustration",
            "unknown"
          ],
          "title": "Support",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "evidence_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Text"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "id",
        "subject_id",
        "predicate",
        "support",
        "source"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Conditions": {
      "additionalProperties": false,
      "description": "来源报告的条件范围与阶段归属；温度 °C、压力 kPa、时长秒，缺失保持 None。",
      "properties": {
        "temperature_min_c": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature Min C"
        },
        "temperature_max_c": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature Max C"
        },
        "pressure_max_kpa": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pressure Max Kpa"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        },
        "equipment": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Equipment"
        },
        "stage_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stage Id"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        }
      },
      "title": "Conditions",
      "type": "object"
    },
    "FeatureStatus": {
      "additionalProperties": false,
      "description": "某项增强能力在当前运行中的评估状态及原因，区别未请求、未支持、未评估和部分完成。",
      "properties": {
        "state": {
          "enum": [
            "completed",
            "partial",
            "not_evaluated",
            "not_supported",
            "not_requested"
          ],
          "title": "State",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "state"
      ],
      "title": "FeatureStatus",
      "type": "object"
    },
    "Material": {
      "additionalProperties": false,
      "description": "某个反应中的具体材料实例；同结构在不同角色/实验中仍有不同 instance_id。",
      "properties": {
        "instance_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Instance Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "reactant",
            "product",
            "reagent",
            "catalyst",
            "solvent"
          ],
          "title": "Role",
          "type": "string"
        },
        "smiles": {
          "title": "Smiles",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "actual_input": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Input"
        }
      },
      "required": [
        "instance_id",
        "role",
        "smiles"
      ],
      "title": "Material",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "description": "绑定一个产品实例的报告观察，保留结果类型、引文、位置及产品对应收率类型。",
      "properties": {
        "product_instance_id": {
          "title": "Product Instance Id",
          "type": "string"
        },
        "result": {
          "default": "unknown",
          "enum": [
            "reported_prepared",
            "analytical_observation",
            "enriched",
            "recovered",
            "failed",
            "unknown",
            "conflict"
          ],
          "title": "Result",
          "type": "string"
        },
        "evidence_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Text"
        },
        "source_location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Location"
        },
        "isolated": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Isolated"
        },
        "yield_pct": {
          "anyOf": [
            {
              "maximum": 105,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Yield Pct"
        },
        "yield_type": {
          "default": "unknown",
          "enum": [
            "isolated",
            "analytical",
            "recovery",
            "unknown"
          ],
          "title": "Yield Type",
          "type": "string"
        }
      },
      "required": [
        "product_instance_id"
      ],
      "title": "Observation",
      "type": "object"
    },
    "Proposal": {
      "additionalProperties": false,
      "description": "经来源回放约束的单反应物替换建议，始终标记为未观察且条件尚未验证。",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "source_reference_id": {
          "title": "Source Reference Id",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "source_step_ref": {
          "title": "Source Step Ref",
          "type": "string"
        },
        "replaced_slot": {
          "title": "Replaced Slot",
          "type": "integer"
        },
        "original_reactants": {
          "items": {
            "type": "string"
          },
          "title": "Original Reactants",
          "type": "array"
        },
        "proposed_reactants": {
          "items": {
            "type": "string"
          },
          "title": "Proposed Reactants",
          "type": "array"
        },
        "target_smiles": {
          "title": "Target Smiles",
          "type": "string"
        },
        "replay_product_sets": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Replay Product Sets",
          "type": "array"
        },
        "enumeration_complete": {
          "title": "Enumeration Complete",
          "type": "boolean"
        },
        "validation_complete": {
          "title": "Validation Complete",
          "type": "boolean"
        },
        "target_found": {
          "title": "Target Found",
          "type": "boolean"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "proposal_not_observed": {
          "const": true,
          "default": true,
          "title": "Proposal Not Observed",
          "type": "boolean"
        },
        "condition_support": {
          "const": "unverified",
          "default": "unverified",
          "title": "Condition Support",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "id",
        "source_reference_id",
        "source",
        "source_step_ref",
        "replaced_slot",
        "original_reactants",
        "proposed_reactants",
        "target_smiles",
        "replay_product_sets",
        "enumeration_complete",
        "validation_complete",
        "target_found",
        "rule_id",
        "limitations"
      ],
      "title": "Proposal",
      "type": "object"
    },
    "QueryFamily": {
      "additionalProperties": false,
      "description": "可序列化的 Markush 查询中间表示，含核心、目标对应、R 谓词和生成规则依据。",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        },
        "layer": {
          "enum": [
            "whole",
            "core",
            "fragment"
          ],
          "title": "Layer",
          "type": "string"
        },
        "core_smarts": {
          "title": "Core Smarts",
          "type": "string"
        },
        "target_atoms": {
          "items": {
            "type": "integer"
          },
          "title": "Target Atoms",
          "type": "array"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "rule_version": {
          "title": "Rule Version",
          "type": "string"
        },
        "r_constraints": {
          "items": {
            "$ref": "#/$defs/RConstraint"
          },
          "title": "R Constraints",
          "type": "array"
        },
        "equal_r_positions": {
          "items": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "title": "Equal R Positions",
          "type": "array"
        },
        "core_topology_policy": {
          "default": "forbid_extra_internal_edges",
          "enum": [
            "forbid_extra_internal_edges",
            "record_extra_internal_edges"
          ],
          "title": "Core Topology Policy",
          "type": "string"
        },
        "allow_extra_substitution": {
          "default": true,
          "title": "Allow Extra Substitution",
          "type": "boolean"
        },
        "use_generic_matchers": {
          "default": true,
          "title": "Use Generic Matchers",
          "type": "boolean"
        },
        "relation": {
          "default": "structural_family",
          "enum": [
            "strict",
            "structural_family"
          ],
          "title": "Relation",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "trigger": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger"
        }
      },
      "required": [
        "id",
        "layer",
        "core_smarts",
        "target_atoms",
        "rule_id",
        "rule_version",
        "description"
      ],
      "title": "QueryFamily",
      "type": "object"
    },
    "RBlock": {
      "additionalProperties": false,
      "description": "核心外一个完整连通支链块；可以有多个边界连接位点，atom_indices 属于具体材料。",
