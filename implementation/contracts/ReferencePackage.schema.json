      "type": "object"
    },
    "RConstraint": {
      "additionalProperties": false,
      "description": "查询核心某位置的完整 R 块限制；position 是查询核心索引，不是全目标索引。",
      "properties": {
        "position": {
          "minimum": 0,
          "title": "Position",
          "type": "integer"
